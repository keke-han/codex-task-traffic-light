#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
LIGHT = os.environ.get("CODEX_LIGHT_PATH") or str(SCRIPT_DIR / "codex-light")
if not os.path.exists(LIGHT):
    LIGHT = shutil.which("codex-light") or LIGHT
STATE_PATH = os.path.expanduser("~/Library/Application Support/CodexTrafficLight/state.json")
LOG_PATH = os.path.expanduser("~/Library/Application Support/CodexTrafficLight/hook.log")


def log(message):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a", encoding="utf-8") as handle:
            handle.write(f"{datetime.now().isoformat(timespec='seconds')} {message}\n")
    except Exception:
        pass


def read_event():
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except Exception as exc:
        log(f"invalid-json {exc}")
        return {}


def set_light(state):
    try:
        subprocess.run([LIGHT, state], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        log(f"set {state}")
    except Exception as exc:
        log(f"set-failed {state} {exc}")


event = read_event()
name = event.get("hook_event_name") or (sys.argv[1] if len(sys.argv) > 1 else "")
log(f"event {name}")

if name in {"UserPromptSubmit", "PreToolUse"}:
    set_light("working")
elif name == "PermissionRequest":
    set_light("waiting")
elif name == "SubagentStop":
    # A child agent finishing does not mean the parent task is complete.
    # Keep the current light unchanged so no completion sound is triggered.
    log("ignored subagent completion; parent task still owns the light")
elif name == "Stop":
    log("Stop observed; session watcher will confirm turn completion")

print("{}")
