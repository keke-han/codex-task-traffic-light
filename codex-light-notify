#!/bin/zsh
set -u

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$DIR/$TARGET" ;;
  esac
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

ORIGINAL="${CODEX_LIGHT_NOTIFY_ORIGINAL:-}"
LIGHT="${CODEX_LIGHT_PATH:-$DIR/codex-light}"
EVENT="${1:-}"

if [ "${CODEX_LIGHT_NOTIFY_SKIP_ORIGINAL:-0}" != "1" ] && [ -n "$ORIGINAL" ] && [ -x "$ORIGINAL" ]; then
  "$ORIGINAL" "$@" >/dev/null 2>&1 || true
fi

if [ "$EVENT" = "turn-start" ]; then
  "$LIGHT" working >/dev/null 2>&1 || true
fi
